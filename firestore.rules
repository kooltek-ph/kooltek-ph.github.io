rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Admin list: add a doc with the admin's UID as the ID (via Firebase Console).
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Price list and other settings: admins only.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    match /jobs/{jobId} {
      // Customers create their own requests as Pending. Admins can create jobs (phone / walk-in).
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && !('billing' in request.resource.data)
        && !('jo' in request.resource.data)
      );

      // Customers read their own (incl. their billing statement); admins read all.
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Customers may only cancel their own Pending request. Admins may update anything.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'Pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'Cancelled'
      );

      allow delete: if isAdmin();
    }
  }
}
